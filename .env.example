# Copiar a .env y completar. NO subir .env al repositorio.
DB_NAME=tienda
DB_USER=tienda
DB_PASSWORD=cambia-esta-clave

# Minimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=

# Usuario administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@tienda.local
ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173
TIENDA_NOMBRE=TechStore

# Limitacion de tasa por IP (ventana de 60 s)
RATE_LIMIT_MAXIMO=300
RATE_LIMIT_AUTH_MAXIMO=10

# simulado (no llama APIs externas) o real (sandbox de la pasarela)
PAGOS_MODO=simulado

# Wompi: llaves publica/privada y secreto de integridad (valida X-Event-Checksum)
WOMPI_API_URL=https://api.sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_REDIRECT_URL=https://TU-DOMINIO-REAL/pago/exitoso

# ePayco: la llave privada valida la cabecera x-signature del webhook
EPAYCO_API_URL=https://api.secure.epayco.co
EPAYCO_APIIFY_URL=https://apify.epayco.co
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=

# Almacenamiento S3-compatible (RustFS) de las imagenes de productos.
# Sin STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY la app arranca pero las subidas fallan.
STORAGE_ENDPOINT=http://192.168.0.150:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tienda-productos-dev
STORAGE_PUBLIC_URL=http://192.168.0.150:9000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=la_misma_clave_de_redis

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=...
MINIO_SECRET_KEY=...
